<!DOCTYPE html>
<html style="width:100%;height:100%;background-color:black;">
<head>
<meta charset="UTF-8" />
<script type="text/javascript">
// ==UserScript==
// @name         Eaglercraft 1.8.8 Macro Recorder
// @namespace    electrospark.macro
// @version      1.0
// @description  Record your keyboard + mouse in Eaglercraft, then replay it (looped, sped up). F8 = record, F9 = play/stop, F10 = hide panel.
// @match        *://*/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function () {
  'use strict';

  const STORE = 'eagMacros_v1';
  const HOTKEY_REC = 'F8', HOTKEY_PLAY = 'F9', HOTKEY_PANEL = 'F10';

  let recording = false, playing = false;
  let recStart = 0, events = [];
  let speed = 1, loop = false;
  let playToken = 0;
  const held = { keys: new Map(), buttons: new Set() };

  const canvas = () => document.querySelector('#game_frame canvas') || document.querySelector('canvas');

  // ---------- background-tab keep-alive ----------
  // Chrome stops requestAnimationFrame and slows timers to ~1/sec in hidden tabs, which freezes the
  // game and the macro. A worker's timer keeps ticking, so we drive both from it while hidden.
  const realHidden = Object.getOwnPropertyDescriptor(Document.prototype, 'hidden').get;
  const isHidden = () => realHidden.call(document);
  const ticker = new Worker(URL.createObjectURL(new Blob(['setInterval(()=>postMessage(0),16)'], { type: 'text/javascript' })));
  const tickSubs = new Set();
  ticker.onmessage = () => { for (const f of [...tickSubs]) f(); };

  const nativeRAF = window.requestAnimationFrame.bind(window);
  const nativeCAF = window.cancelAnimationFrame.bind(window);
  let rafId = 0, lastRealFrame = performance.now(); const rafMap = new Map();
  window.requestAnimationFrame = function (cb) {
    const id = ++rafId;
    const run = (ts) => { if (!rafMap.has(id)) return; cleanup(); cb(ts); };
    const native = (ts) => { lastRealFrame = performance.now(); run(ts); };
    // Watchdog: Chrome sometimes stops real frames without reporting the tab as hidden
    // (other tab in front, window covered/minimized), so once no real frame has come for
    // 100ms, worker ticks drive the game at ~60fps instead. Whichever fires first wins.
    const viaTick = () => { const now = performance.now(); if (isHidden() || now - lastRealFrame > 100) run(now); };
    const cleanup = () => { const e = rafMap.get(id); rafMap.delete(id); if (e) { nativeCAF(e.n); tickSubs.delete(viaTick); } };
    rafMap.set(id, { n: nativeRAF(native), viaTick });
    tickSubs.add(viaTick);
    return id;
  };
  window.cancelAnimationFrame = function (id) {
    const e = rafMap.get(id); if (!e) return;
    rafMap.delete(id); nativeCAF(e.n); tickSubs.delete(e.viaTick);
  };

  // Tell the game the tab is always visible + focused so it doesn't pause itself.
  Object.defineProperty(Document.prototype, 'hidden', { configurable: true, get: () => false });
  Object.defineProperty(Document.prototype, 'visibilityState', { configurable: true, get: () => 'visible' });
  Document.prototype.hasFocus = () => true;
  for (const t of ['visibilitychange', 'blur', 'pagehide', 'freeze']) {
    window.addEventListener(t, (e) => { if (e.target === window || e.target === document) e.stopImmediatePropagation(); }, true);
    document.addEventListener(t, (e) => e.stopImmediatePropagation(), true);
  }
  // While a macro plays, keep the game believing the mouse is still captured after you switch tabs,
  // so mouse-look and clicks keep working instead of dropping into the pause menu.
  const realPLE = Object.getOwnPropertyDescriptor(Document.prototype, 'pointerLockElement').get;
  Object.defineProperty(Document.prototype, 'pointerLockElement', { configurable: true,
    get() { const r = realPLE.call(this); return r || (playing ? canvas() : null); } });
  document.addEventListener('pointerlockchange', (e) => { if (playing && !realPLE.call(document)) e.stopImmediatePropagation(); }, true);

  // A near-silent audio tone stops Chrome from freezing/throttling the tab after a few minutes.
  let keepAudio = null;
  function startKeepAlive() {
    if (keepAudio) return;
    try {
      const ac = new AudioContext(); const o = ac.createOscillator(); const g = ac.createGain();
      o.frequency.value = 20; g.gain.value = 0.001; o.connect(g).connect(ac.destination); o.start();
      keepAudio = ac;
    } catch {}
  }
  window.addEventListener('mousedown', startKeepAlive, true);
  window.addEventListener('keydown', startKeepAlive, true);
  const isOurUI = (e) => e.target && e.target.closest && e.target.closest('#eagMacroPanel');

  // ---------- recording ----------
  function onEvent(e) {
    if (!e.isTrusted || isOurUI(e)) return;
    if (e.type.startsWith('key') && [HOTKEY_REC, HOTKEY_PLAY, HOTKEY_PANEL].includes(e.code)) return;
    if (!recording) return;
    const t = performance.now() - recStart;
    const ev = { t, type: e.type };
    if (e.type.startsWith('key')) {
      // repeats are kept so held Backspace / held letters in chat replay correctly
      Object.assign(ev, { key: e.key, code: e.code, keyCode: e.keyCode, shift: e.shiftKey, ctrl: e.ctrlKey, alt: e.altKey, repeat: e.repeat });
    } else if (e.type === 'mousemove') {
      ev.dx = e.movementX; ev.dy = e.movementY; ev.x = e.clientX; ev.y = e.clientY;
      // merge tiny consecutive moves to keep macros small
      const last = events[events.length - 1];
      if (last && last.type === 'mousemove' && t - last.t < 8) { last.dx += ev.dx; last.dy += ev.dy; last.x = ev.x; last.y = ev.y; return; }
    } else if (e.type === 'wheel') {
      ev.deltaY = e.deltaY; ev.x = e.clientX; ev.y = e.clientY;
    } else {
      ev.button = e.button; ev.x = e.clientX; ev.y = e.clientY;
    }
    events.push(ev);
    updateUI();
  }
  ['keydown', 'keyup', 'keypress', 'mousedown', 'mouseup', 'mousemove', 'wheel'].forEach((t) =>
    window.addEventListener(t, onEvent, true));

  function startRec() {
    if (playing) stopPlay();
    events = []; recStart = performance.now(); recording = true;
    toast('● Recording — press F8 to stop'); updateUI();
  }
  function stopRec() {
    recording = false;
    toast(`Recorded ${events.length} inputs (${fmt(duration())})`); updateUI();
  }

  // ---------- replay ----------
  function fakeKey(type, ev) {
    const k = new KeyboardEvent(type, { key: ev.key, code: ev.code, shiftKey: !!ev.shift, ctrlKey: !!ev.ctrl, altKey: !!ev.alt,
      repeat: !!ev.repeat, bubbles: true, cancelable: true });
    // Eaglercraft reads keyCode/which/charCode, which the constructor ignores
    const cc = type === 'keypress' && ev.key && ev.key.length === 1 ? ev.key.charCodeAt(0) : 0;
    Object.defineProperty(k, 'keyCode', { get: () => (type === 'keypress' ? cc : ev.keyCode) });
    Object.defineProperty(k, 'which', { get: () => (type === 'keypress' ? cc : ev.keyCode) });
    Object.defineProperty(k, 'charCode', { get: () => cc });
    // when chat is open the game may be listening on a focused element instead of the canvas
    const tgt = document.activeElement && document.activeElement !== document.body ? document.activeElement : (canvas() || window);
    const notBlocked = tgt.dispatchEvent(k);
    // Newer clients type through a hidden <input>; fake key events never insert text on their own,
    // so do what the browser would do for a real key press.
    if (notBlocked && /^(INPUT|TEXTAREA)$/.test(tgt.tagName)) {
      const edit = (inputType, data, cmd) => {
        // the game listens for beforeinput and cancels it; only fall back to a real edit if it didn't
        const bi = new InputEvent('beforeinput', { inputType, data, bubbles: true, cancelable: true, composed: true });
        if (tgt.dispatchEvent(bi)) document.execCommand(cmd, false, data);
      };
      if (type === 'keypress' && cc) edit('insertText', ev.key, 'insertText');
      else if (type === 'keydown' && ev.code === 'Backspace') edit('deleteContentBackward', null, 'delete');
      else if (type === 'keydown' && ev.code === 'Delete') edit('deleteContentForward', null, 'forwardDelete');
    }
  }
  function fakeMouse(type, ev) {
    const init = { bubbles: true, cancelable: true, clientX: ev.x, clientY: ev.y, button: ev.button || 0,
      buttons: [...held.buttons].reduce((m, b) => m | (1 << (b === 1 ? 2 : b === 2 ? 1 : b)), 0) };
    const m = new MouseEvent(type, init);
    if (type === 'mousemove') {
      Object.defineProperty(m, 'movementX', { get: () => ev.dx });
      Object.defineProperty(m, 'movementY', { get: () => ev.dy });
    }
    (canvas() || window).dispatchEvent(m);
  }
  function fire(ev) {
    switch (ev.type) {
      case 'keydown': held.keys.set(ev.code, ev); fakeKey('keydown', ev); break;
      case 'keyup': held.keys.delete(ev.code); fakeKey('keyup', ev); break;
      case 'keypress': fakeKey('keypress', ev); break;
      case 'mousedown': held.buttons.add(ev.button); fakeMouse('mousedown', ev); break;
      case 'mouseup': held.buttons.delete(ev.button); fakeMouse('mouseup', ev); break;
      case 'mousemove': fakeMouse('mousemove', ev); break;
      case 'wheel': (canvas() || window).dispatchEvent(new WheelEvent('wheel', { deltaY: ev.deltaY, clientX: ev.x, clientY: ev.y, bubbles: true, cancelable: true })); break;
    }
  }
  function releaseAll() {
    for (const ev of held.keys.values()) fakeKey('keyup', ev);
    for (const b of held.buttons) fakeMouse('mouseup', { button: b, x: 0, y: 0 });
    held.keys.clear(); held.buttons.clear();
  }

  function startPlay() {
    if (!events.length) return toast('Nothing recorded yet (F8)');
    if (recording) stopRec();
    startKeepAlive();
    if (!document.pointerLockElement) toast('Tip: click into the game first so mouse-look replays');
    playing = true; const token = ++playToken; updateUI();
    const runOnce = () => new Promise((resolve) => {
      const t0 = performance.now(); let i = 0;
      const tick = () => {
        if (token !== playToken) return resolve(false);
        const now = (performance.now() - t0) * speed;
        while (i < events.length && events[i].t <= now) fire(events[i++]);
        if (i >= events.length) { releaseAll(); return resolve(true); }
        if (isHidden()) { const once = () => { tickSubs.delete(once); tick(); }; tickSubs.add(once); }
        else setTimeout(tick, 4);
      };
      tick();
    });
    (async () => {
      let n = 0;
      do {
        n++; toast(`▶ Playing${loop ? ` (loop #${n})` : ''} at ${speed}x — F9 to stop`);
        if (!(await runOnce())) return;
      } while (loop && token === playToken);
      stopPlay();
    })();
  }
  function stopPlay() {
    playToken++; playing = false; releaseAll(); toast('■ Stopped'); updateUI();
  }

  // ---------- hotkeys ----------
  window.addEventListener('keydown', (e) => {
    if (!e.isTrusted) return;
    if (e.code === HOTKEY_REC) { e.preventDefault(); e.stopImmediatePropagation(); recording ? stopRec() : startRec(); }
    else if (e.code === HOTKEY_PLAY) { e.preventDefault(); e.stopImmediatePropagation(); playing ? stopPlay() : startPlay(); }
    else if (e.code === HOTKEY_PANEL) { e.preventDefault(); e.stopImmediatePropagation(); panel && (panel.style.display = panel.style.display === 'none' ? '' : 'none'); }
    else if (playing && e.code === 'Escape') stopPlay(); // safety: Esc always kills a running macro
  }, true);

  // ---------- typed steps (commands / chat / single keys) ----------
  const SYM = { ' ': ['Space', 32], '/': ['Slash', 191], '-': ['Minus', 189], '=': ['Equal', 187], '.': ['Period', 190],
    ',': ['Comma', 188], ';': ['Semicolon', 186], "'": ['Quote', 222], '[': ['BracketLeft', 219], ']': ['BracketRight', 221],
    '\\': ['Backslash', 220], '`': ['Backquote', 192] };
  const SHIFTED = { '~': '`', '!': '1', '@': '2', '#': '3', $: '4', '%': '5', '^': '6', '&': '7', '*': '8', '(': '9', ')': '0',
    _: '-', '+': '=', '{': '[', '}': ']', '|': '\\', ':': ';', '"': "'", '<': ',', '>': '.', '?': '/' };
  const NAMED = { enter: ['Enter', 'Enter', 13], esc: ['Escape', 'Escape', 27], escape: ['Escape', 'Escape', 27], tab: ['Tab', 'Tab', 9],
    backspace: ['Backspace', 'Backspace', 8], space: [' ', 'Space', 32], shift: ['Shift', 'ShiftLeft', 16], ctrl: ['Control', 'ControlLeft', 17],
    up: ['ArrowUp', 'ArrowUp', 38], down: ['ArrowDown', 'ArrowDown', 40], left: ['ArrowLeft', 'ArrowLeft', 37], right: ['ArrowRight', 'ArrowRight', 39] };
  function keyInfo(ch) {
    if (/^[a-z]$/i.test(ch)) return { key: ch, code: 'Key' + ch.toUpperCase(), keyCode: ch.toUpperCase().charCodeAt(0), shift: ch !== ch.toLowerCase() };
    if (/^[0-9]$/.test(ch)) return { key: ch, code: 'Digit' + ch, keyCode: ch.charCodeAt(0), shift: false };
    if (SYM[ch]) return { key: ch, code: SYM[ch][0], keyCode: SYM[ch][1], shift: false };
    if (SHIFTED[ch]) { const b = keyInfo(SHIFTED[ch]); return { ...b, key: ch, shift: true }; }
    const n = NAMED[ch.toLowerCase()];
    if (n) return { key: n[0], code: n[1], keyCode: n[2], shift: false };
    return { key: ch, code: '', keyCode: 0, shift: false };
  }
  // appends a full press (down, press, up) at time t; returns the time after it
  function pushPress(list, t, info, hold = 40) {
    list.push({ t, type: 'keydown', ...info });
    if (info.key.length === 1) list.push({ t: t + 1, type: 'keypress', ...info });
    list.push({ t: t + hold, type: 'keyup', ...info });
    return t + hold + 25;
  }
  const endT = () => (events.length ? events[events.length - 1].t + 150 : 300);
  function addChat(text) {
    let t = endT();
    // "/" opens chat already holding the slash, otherwise T opens it
    const isCmd = text.startsWith('/');
    t = pushPress(events, t, keyInfo(isCmd ? '/' : 't')) + 250; // give the chat screen time to open
    for (const ch of isCmd ? text.slice(1) : text) t = pushPress(events, t, keyInfo(ch), 20);
    pushPress(events, t + 100, keyInfo('enter'));
    updateUI();
  }
  function addKey(name, holdMs) { pushPress(events, endT(), keyInfo(name), holdMs); updateUI(); }
  function addWait(ms) { const t = endT() + ms; events.push({ t, type: 'wait' }); updateUI(); }

  // ---------- storage ----------
  const loadAll = () => { try { return JSON.parse(localStorage.getItem(STORE)) || {}; } catch { return {}; } };
  const saveAll = (o) => { try { localStorage.setItem(STORE, JSON.stringify(o)); } catch (e) { toast('Save failed: ' + e.message); } };
  const duration = () => (events.length ? events[events.length - 1].t : 0);
  const fmt = (ms) => (ms / 1000).toFixed(1) + 's';

  // ---------- UI ----------
  let panel, statusEl, listEl, toastEl, toastTimer;
  function toast(msg) {
    if (!toastEl) return;
    toastEl.textContent = msg; toastEl.style.opacity = '1';
    clearTimeout(toastTimer); toastTimer = setTimeout(() => (toastEl.style.opacity = '0'), 2500);
  }
  function updateUI() {
    if (!statusEl) return;
    statusEl.textContent = recording ? `● REC ${events.length} inputs` : playing ? `▶ PLAYING ${speed}x` : `Ready · ${events.length} inputs · ${fmt(duration())}`;
    statusEl.style.color = recording ? '#ff5555' : playing ? '#55ff55' : '#ddd';
  }
  function refreshList() {
    const all = loadAll(); listEl.innerHTML = '';
    Object.keys(all).forEach((name) => {
      const row = document.createElement('div'); row.className = 'row';
      row.innerHTML = `<span>${name.replace(/</g, '&lt;')} <small>${fmt(all[name].at(-1)?.t || 0)}</small></span>`;
      const ld = btn('Load', () => { events = all[name]; toast(`Loaded "${name}"`); updateUI(); });
      const del = btn('✕', () => { delete all[name]; saveAll(all); refreshList(); });
      row.append(ld, del); listEl.append(row);
    });
  }
  function btn(label, fn) { const b = document.createElement('button'); b.textContent = label; b.onclick = (e) => { e.stopPropagation(); fn(); b.blur(); }; return b; }

  function buildUI() {
    if (!canvas()) return setTimeout(buildUI, 1000); // wait for Eaglercraft to boot
    const css = document.createElement('style');
    css.textContent = `
      #eagMacroPanel{position:fixed;top:10px;right:10px;z-index:2147483647;width:230px;background:rgba(15,15,20,.88);
        color:#ddd;font:12px monospace;border:2px solid #555;border-radius:6px;padding:8px;user-select:none}
      #eagMacroPanel h4{margin:0 0 6px;color:#ffaa00;font-size:13px;cursor:move}
      #eagMacroPanel button{background:#3a3a3a;color:#fff;border:1px solid #777;border-radius:3px;padding:3px 6px;margin:2px;cursor:pointer;font:11px monospace}
      #eagMacroPanel button:hover{background:#555}
      #eagMacroPanel .row{display:flex;align-items:center;justify-content:space-between;gap:4px}
      #eagMacroPanel .row span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      #eagMacroPanel input[type=range]{width:110px}
      #eagMacroList{max-height:120px;overflow:auto;margin-top:4px;border-top:1px solid #444}
      #eagMacroToast{position:fixed;left:50%;top:40px;transform:translateX(-50%);z-index:2147483647;background:rgba(0,0,0,.75);
        color:#fff;font:14px monospace;padding:6px 12px;border-radius:4px;pointer-events:none;opacity:0;transition:opacity .3s}`;
    document.head.append(css);

    panel = document.createElement('div'); panel.id = 'eagMacroPanel';
    panel.innerHTML = `<h4>⚡ Macro (F8 rec · F9 play · F10 hide)</h4><div id="eagStatus"></div>
      <div class="row"><span>Speed <b id="eagSpd">1x</b></span><input id="eagSpeed" type="range" min="0.25" max="5" step="0.25" value="1"></div>
      <label><input id="eagLoop" type="checkbox"> Loop forever</label><div id="eagBtns"></div><div id="eagMacroList"></div>`;
    document.body.append(panel);
    toastEl = document.createElement('div'); toastEl.id = 'eagMacroToast'; document.body.append(toastEl);
    statusEl = panel.querySelector('#eagStatus'); listEl = panel.querySelector('#eagMacroList');

    const sp = panel.querySelector('#eagSpeed');
    sp.oninput = () => { speed = +sp.value; panel.querySelector('#eagSpd').textContent = speed + 'x'; updateUI(); };
    panel.querySelector('#eagLoop').onchange = (e) => (loop = e.target.checked);

    const b = panel.querySelector('#eagBtns');
    b.append(
      btn('● Rec', () => (recording ? stopRec() : startRec())),
      btn('▶ Play', () => (playing ? stopPlay() : startPlay())),
      btn('+ Command', () => {
        const txt = prompt('Command or chat message to add (e.g. /time set day or hello):'); if (!txt) return;
        addChat(txt); toast(`Added: ${txt}`);
      }),
      btn('+ Key', () => {
        const k = prompt('Key to press (a letter, number, or: enter, esc, space, shift, tab, up/down/left/right). Add ":ms" to hold, e.g. w:2000'); if (!k) return;
        const [name, ms] = k.split(':'); addKey(name.trim(), +ms || 60); toast(`Added key ${name}`);
      }),
      btn('+ Wait', () => {
        const s = prompt('Wait how many seconds?', '1'); if (!s || isNaN(+s)) return;
        addWait(+s * 1000); toast(`Added ${s}s wait`);
      }),
      btn('Clear', () => { if (playing) stopPlay(); events = []; updateUI(); toast('Cleared'); }),
      btn('Save', () => {
        if (!events.length) return toast('Nothing to save');
        const name = prompt('Macro name:'); if (!name) return;
        const all = loadAll(); all[name] = events; saveAll(all); refreshList(); toast(`Saved "${name}"`);
      }),
      btn('Export', () => {
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([JSON.stringify(events)], { type: 'application/json' }));
        a.download = 'eaglercraft-macro.json'; a.click();
      }),
      btn('Import', () => {
        const f = document.createElement('input'); f.type = 'file'; f.accept = '.json';
        f.onchange = async () => { try { events = JSON.parse(await f.files[0].text()); toast('Imported'); updateUI(); } catch { toast('Bad file'); } };
        f.click();
      })
    );

    // drag by title
    const h = panel.querySelector('h4'); let drag = null;
    h.onmousedown = (e) => { drag = { x: e.clientX - panel.offsetLeft, y: e.clientY - panel.offsetTop }; };
    window.addEventListener('mousemove', (e) => { if (drag) { panel.style.left = e.clientX - drag.x + 'px'; panel.style.top = e.clientY - drag.y + 'px'; panel.style.right = 'auto'; } });
    window.addEventListener('mouseup', () => (drag = null));

    refreshList(); updateUI();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', buildUI); else buildUI();
})();

</script>


